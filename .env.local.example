# Copia questo file in .env.local e riempi i valori reali.
# NON committare mai .env.local (è già in .gitignore).

# Postgres (Neon, creato da Vercel Storage) — impostata automaticamente da Vercel
DATABASE_URL=

# Meta App "AINexAgent"
META_APP_ID=
META_APP_SECRET=

# Bearer token per proteggere gli endpoint /api/cron/*
CRON_SECRET=

# Vercel Blob Store (Storage → Blob → .env.local) — solo per gli script locali di upload
BLOB_READ_WRITE_TOKEN=
